# Wajib: Supabase Data API / Auth / Storage
# Ambil dari Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
# "anon key" atau "publishable key" (aman di browser selama RLS aktif)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opsional: hanya untuk tooling sisi server. JANGAN pernah dipakai di kode client.
SUPABASE_SERVICE_ROLE_KEY=

# Notifikasi admin lewat Edge Function (opsional)
# Buat random: openssl rand -hex 32
NOTIFY_SECRET=

# URL situs untuk canonical URL, sitemap, dan metadata Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000
